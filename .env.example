# Nusxa oling: cp .env.example .env  (.env gitga tushmaydi)

# --- AI ---
# false (standart): LLM'ga so'rov yuborilmaydi, statik "Demo rejim" javoblari qaytariladi.
# LLM'ni yoqish uchun AI_ENABLED=true qiling va quyidagilarni to'ldiring.
AI_ENABLED=false
# OpenAI-mos API (Groq, lokal vLLM, ...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=
LLM_TIMEOUT=30

# --- PostgreSQL (compose ichida; host portiga ochilmaydi) ---
POSTGRES_USER=clinic
# Generatsiya: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=clinic

# --- Boshlang'ich ma'lumotlar ---
# SEED_DEMO=false (standart): demo ma'lumotlar yuklanmaydi. Bazada foydalanuvchi bo'lmasa,
# ADMIN_EMAIL va ADMIN_PASSWORD (kamida 10 belgi) MAJBURIY, aks holda backend ishga tushmaydi.
# Lokal ishlash uchun .env da SEED_DEMO=true qiling: bo'sh bazaga demo ma'lumotlar va
# demo hisoblar (admin@clinic.uz / password123 va boshqalar) yuklanadi. Productionda hech qachon!
SEED_DEMO=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Auth ---
# Generatsiya: openssl rand -hex 32   (kamida 32 belgi, bo'sh bo'lsa backend ishga tushmaydi)
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Vergul bilan ajratilgan originlar ('*' mumkin emas)
CORS_ORIGINS=http://localhost:5180
