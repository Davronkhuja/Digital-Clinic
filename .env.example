# Nusxa oling: cp .env.example .env  (.env gitga tushmaydi)

# --- AI ---
# false (standart): LLM'ga so'rov yuborilmaydi, statik "Demo rejim" javoblari qaytariladi.
# LLM'ni yoqish uchun AI_ENABLED=true qiling va quyidagilarni to'ldiring.
AI_ENABLED=false
# OpenAI-mos API (Groq, lokal vLLM, ...)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=
LLM_TIMEOUT=30
# Lokal LLM (vLLM/Ollama, OpenAI-mos): LLM_BASE_URL=http://gpu-host:8000/v1, LLM_MODEL=<model>, LLM_REQUIRE_KEY=false. AI_ENABLED=true kerak.
# Qayd xulosasi faqat lokal/ichki LLM'ga ketadi; tashqi xizmat uchun LLM_ALLOW_EXTERNAL_PHI=true (ongli qaror).
LLM_REQUIRE_KEY=true
LLM_ALLOW_EXTERNAL_PHI=false

# --- PostgreSQL (compose ichida; host portiga ochilmaydi) ---
POSTGRES_USER=clinic
# Generatsiya: openssl rand -hex 16
POSTGRES_PASSWORD=
POSTGRES_DB=clinic

# --- Boshlang'ich ma'lumotlar ---
# SEED_DEMO=false (standart): demo ma'lumotlar yuklanmaydi. Bazada foydalanuvchi bo'lmasa,
# ADMIN_EMAIL va ADMIN_PASSWORD (kamida 10 belgi) MAJBURIY, aks holda backend ishga tushmaydi.
# Lokal ishlash uchun .env da SEED_DEMO=true qiling: bo'sh bazaga demo ma'lumotlar va
# demo hisoblar (admin@clinic.uz / password123 va boshqalar) yuklanadi. Productionda hech qachon!
SEED_DEMO=false
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Auth ---
# Generatsiya: openssl rand -hex 32   (kamida 32 belgi, bo'sh bo'lsa backend ishga tushmaydi)
JWT_SECRET=
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# --- CORS ---
# Vergul bilan ajratilgan originlar ('*' mumkin emas)
CORS_ORIGINS=http://localhost:5180

# --- Fayl ilovalari (EMR) ---
# local: docker volume (/data/uploads). Keyinchalik S3/MinIO uchun alohida backend qo'shiladi.
STORAGE_BACKEND=local
STORAGE_DIR=/data/uploads
# Bitta fayl hajmi (MB); frontend nginx client_max_body_size shundan katta bo'lishi kerak
MAX_UPLOAD_MB=20

# --- Payme Merchant API (kalitlar FAQAT .env da; bo'sh bo'lsa Payme endpoint hamma so'rovni rad etadi) ---
# Kabinet: https://merchant.paycom.uz  -> Merchant ID va kalitlar
PAYME_MERCHANT_ID=
PAYME_KEY=
PAYME_TEST_KEY=
# true: sandbox (PAYME_TEST_KEY, test.paycom.uz). Productionda false va PAYME_KEY
PAYME_TEST_MODE=true
# Chek qatorida o'lchov birligi kodi (taxmin 796 = dona; Payme klassifikatoridan tasdiqlang)
PAYME_UNITS_CODE=796

# --- Fiskal chek (virtual kassa) ---
# Hozircha faqat mock (chek ID saqlanadi). Real operator uchun hujjat va kalit kerak.
FISCAL_BACKEND=mock

# --- Click SHOP API (kalitlar FAQAT .env da; maxfiy kalit bo'sh bo'lsa Click endpoint hamma so'rovni rad etadi) ---
# Kabinet: https://merchant.click.uz  -> service_id, merchant_id, secret_key
CLICK_SERVICE_ID=
CLICK_MERCHANT_ID=
CLICK_SECRET_KEY=
CLICK_TEST_SECRET_KEY=
# true: sandbox (CLICK_TEST_SECRET_KEY). Productionda false va CLICK_SECRET_KEY
CLICK_TEST_MODE=true

# --- Xabarlar (Redis + Celery, SMS, Telegram) ---
REDIS_URL=redis://redis:6379/0
# Xabardagi havolalar (tasdiqlash, onlayn yozilish) uchun ochiq manzil
PUBLIC_BASE_URL=http://localhost:5180
# SMS: hozircha faqat mock (mahalliy provayder adapteri hujjat va kalit bilan)
# Muhit: development | test | production. Production'da SMS_BACKEND=mock bilan backend ishga tushmaydi.
APP_ENV=development
SMS_BACKEND=mock
# Faqat dev/test (e2e): mock SMS matnlari (OTP) shu faylga yoziladi; oddiy jurnalga yozilmaydi. Production'da bo'sh.
MOCK_SMS_OUTBOX=
# Telegram bot tokeni (BotFather); bo'sh bo'lsa mock. Faqat .env da
TELEGRAM_BOT_TOKEN=
# Imzolangan havolalar kaliti (bo'sh: JWT_SECRET dan olinadi)
LINK_SECRET=
